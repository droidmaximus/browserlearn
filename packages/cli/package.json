{
  "name": "browserlearn",
  "version": "0.1.0",
  "description": "Local-first browser agent training: record a Chrome task, compile workflows, run via MCP (Claude/Cursor) or export Playwright/Stagehand. Privacy-preserving MIT OSS.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "browser-automation",
    "mcp",
    "model-context-protocol",
    "playwright",
    "stagehand",
    "ai-agents",
    "chrome-extension",
    "local-first",
    "privacy",
    "claude",
    "cursor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/droidmaximus/browserlearn.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/droidmaximus/browserlearn#readme",
  "bugs": {
    "url": "https://github.com/droidmaximus/browserlearn/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "browserlearn": "./dist/bin.js"
  },
  "files": ["dist", "public"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build --workspace @browserlearn/core && npm run build",
    "test": "npm run build --workspace @browserlearn/core && npm run build && tsc -p tsconfig.test.json && vitest run"
  },
  "dependencies": {
    "@browserlearn/core": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright-core": "^1.64.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "playwright": "^1.64.1"
  }
}
