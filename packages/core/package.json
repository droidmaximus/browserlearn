{
  "name": "@browserlearn/core",
  "version": "0.1.0",
  "description": "BrowserLearn core: local redaction, deterministic workflow compiler, Playwright/Stagehand exporters, and SQLite storage.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "browser-automation",
    "playwright",
    "stagehand",
    "redaction",
    "workflow-compiler",
    "ai-agents",
    "local-first"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/droidmaximus/browserlearn.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/droidmaximus/browserlearn#readme",
  "bugs": {
    "url": "https://github.com/droidmaximus/browserlearn/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./types": { "types": "./dist/types.d.ts", "default": "./dist/types.js" },
    "./schema": { "types": "./dist/schema.d.ts", "default": "./dist/schema.js" },
    "./redact": { "types": "./dist/redact.d.ts", "default": "./dist/redact.js" },
    "./compile": { "types": "./dist/compile.d.ts", "default": "./dist/compile.js" },
    "./enrich": { "types": "./dist/enrich.d.ts", "default": "./dist/enrich.js" },
    "./llm": { "types": "./dist/llm.d.ts", "default": "./dist/llm.js" },
    "./export": { "types": "./dist/export/index.d.ts", "default": "./dist/export/index.js" },
    "./store": { "types": "./dist/store.d.ts", "default": "./dist/store.js" },
    "./public": { "types": "./dist/public.d.ts", "default": "./dist/public.js" },
    "./resolve": { "types": "./dist/resolve.d.ts", "default": "./dist/resolve.js" },
    "./protocol": { "types": "./dist/protocol.d.ts", "default": "./dist/protocol.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "tsc -p tsconfig.test.json && vitest run"
  },
  "publishConfig": {
    "access": "public"
  }
}
